{
  // Template for the product build. Per-client configs are generated by `npm run provision`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uat-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/theme.css", "/brand/*", "/favicon.ico"]},
  "observability": {"enabled": true},
  "d1_databases": [{"binding": "DB", "database_name": "uat-template", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "DOCS", "bucket_name": "uat-template-docs"}],
  "vars": {
    "DEPLOYMENT_ID": "template",
    "ACCESS_TEAM_DOMAIN": "https://TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME",
    "BOOTSTRAP_ADMINS": "admin@example.com",
    "ALLOWED_DOMAINS": ""
  }
}
