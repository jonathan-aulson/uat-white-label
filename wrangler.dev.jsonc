// LOCAL ONLY. Never deploy this configuration. Bypass also requires a loopback hostname.
{
  "name": "uat-local-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/theme.css", "/brand/*", "/favicon.ico"]},
  "d1_databases": [{"binding": "DB", "database_name": "uat", "database_id": "local", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "DOCS", "bucket_name": "uat-local-docs"}],
  "vars": {
    "DEPLOYMENT_ID": "local-dev",
    "ACCESS_TEAM_DOMAIN": "https://TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME",
    "BOOTSTRAP_ADMINS": "admin@example.com",
    "ALLOWED_DOMAINS": "",
    "DEV_AUTH_BYPASS": "1",
    "OPEN_ACCESS": "1"
  }
}
