{
  "name": "white-label-uat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc --local --port 8787",
    "migrate:local": "wrangler d1 migrations apply uat --config wrangler.dev.jsonc --local",
    "typecheck": "tsc --noEmit",
