  "dependencies": { "jose": "^6.1.0", "pdf-lib": "^1.17.1" },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "~3.2.0",
    "wrangler": "latest"
  },
  "engines": { "node": ">=24" }
}
